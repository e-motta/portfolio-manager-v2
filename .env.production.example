# Production environment variables for docker-compose
# Copy to .env.production and fill in values
#
# Secrets are loaded from OCI Vault at app startup via the OCI Python SDK.
# Only OCI_VAULT_OCID and OCI_COMPARTMENT_ID are needed here; the app fetches
# the rest from Vault using instance principal authentication.
#
# See docs/deploy-oci.md for full setup instructions.

# Application
APP_ENV=production

# OCI Vault configuration (required for production)
# The app loads secrets from Vault at startup using instance principal auth
OCI_VAULT_OCID=ocid1.vault.oc1.xxx.yyy
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxx

# ============================================================================
# FALLBACK: If not using OCI Vault, set these directly (less secure)
# ============================================================================

# Database
# DATABASE_URL=postgresql+psycopg://portfolio:PASSWORD@postgres:5432/portfolio

# Session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# SECRET_KEY=

# Postgres password (used by postgres container)
# POSTGRES_PASSWORD=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://finance.eduardomotta.dev/auth/callback

# Cumbuca Open Finance (optional)
# CUMBUCA_REDIRECT_URI=https://finance.eduardomotta.dev/auth/cumbuca/callback

# Email allowlist (optional, comma-separated)
# ALLOWED_GOOGLE_EMAILS=user@example.com
