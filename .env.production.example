# OCI Vault Configuration for Production Deployment
#
# These are the ONLY environment variables needed for production.
# All secrets (SECRET_KEY, DATABASE_URL, GOOGLE_* etc.) are loaded from
# OCI Vault by the deploy.py script at runtime. Secrets are never written
# to disk - they exist only in process memory.
#
# Usage:
#   export OCI_VAULT_OCID="ocid1.vault.oc1.xxx.yyy"
#   export OCI_COMPARTMENT_ID="ocid1.compartment.oc1..xxx"
#   ./scripts/deploy.py up -d --build
#
# See docs/deploy-oci.md for full setup instructions.

OCI_VAULT_OCID=ocid1.vault.oc1.xxx.yyy
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxx
