# Environment: development (default) or production
APP_ENV=development

# Database
# Local development: SQLite
DATABASE_URL=sqlite:///./local.db
# Production: Postgres (required when APP_ENV=production)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/portfolio

# Session signing — generate a stable value for production
# In production, load from OCI Vault; must be at least 32 characters
SECRET_KEY=change-me-to-a-random-string

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development:
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Production:
# GOOGLE_REDIRECT_URI=https://finance.eduardomotta.dev/auth/callback

# Cumbuca Open Finance MCP — https://www.cumbuca.com/launchweek/of-data-mcp/
CUMBUCA_MCP_URL=https://mcp.cumbuca.com/mcp
CUMBUCA_AUTH_SERVER=https://idc.cumbuca.com/realms/cumbuca-mcp
# Development:
CUMBUCA_REDIRECT_URI=http://127.0.0.1:8000/auth/cumbuca/callback
# Production:
# CUMBUCA_REDIRECT_URI=https://finance.eduardomotta.dev/auth/cumbuca/callback

# Email allowlist (optional) — comma-separated list of Google emails
# If set, only these emails can complete login; if unset, any Google account works
# ALLOWED_GOOGLE_EMAILS=user@example.com,another@example.com
